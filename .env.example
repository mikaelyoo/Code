# Sienge API auth — Basic Auth (recommended)
SIENGE_SUBDOMAIN=your_subdomain
SIENGE_USERNAME=your_api_username
SIENGE_PASSWORD=your_api_password
SIENGE_BASE_URL=https://api.sienge.com.br
REQUEST_TIMEOUT=60

# Alternative: Bearer token auth (only if your Sienge tenant supports it)
# SIENGE_API_KEY=your_bearer_token
